FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
top
{
    type            fixedValue;
    value           uniform 0;
}


bottom
{
    type            zeroGradient;
}

back
{
  type           constantAlphaContactAngle;
  theta0         45;
  limit          gradient;
  value          uniform 0;

    // type            zeroGradient;
}
front
{
  type           constantAlphaContactAngle;
  theta0         45;
  limit          gradient;
  value          uniform 0;

    // type            zeroGradient;
}
inlet
{
  type           constantAlphaContactAngle;
  theta0         45;
  limit          gradient;
  value          uniform 0;

    // type            zeroGradient;
}
outlet
{
  type           constantAlphaContactAngle;
theta0         45;
limit          gradient;
value          uniform 0;

    // type            zeroGradient;
}
}



// ************************************************************************* //
